local caches = {
    REMOTES={}, DECALS={}, MODELS={}, ASSETS={}, SCRIPTS={}, PROPS={},
    VALUES={}, SOUNDS={}, ANIMS={}, PARTS={}, LIGHTS={},
}
local dumpTab = "REMOTES"
local dumpSearchText = ""

local function match(name, path)
    if dumpSearchText == "" then return true end
    local q = dumpSearchText:lower()
    return name:lower():find(q, 1, true) ~= nil or (path and path:lower():find(q, 1, true) ~= nil)
end

local function walkRoots(roots, limit, fn)
    local v = 0
    for _, root in ipairs(roots) do
        if v >= (limit or math.huge) then break end
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok and list then
            for _, obj in ipairs(list) do
                v = v + 1
                if v >= (limit or math.huge) then break end
                pcall(fn, obj, v)
                if v % 500 == 0 then task.wait() end
            end
        end
    end
    return v
end

local function scanRemotes()
    local list, seen = {}, {}
    walkRoots({ReplicatedStorage, Workspace, PlayerGui, LocalPlayer,
        game:GetService("ServerScriptService"), game:GetService("StarterGui"),
        game:GetService("StarterPlayer"), game:GetService("ServerStorage"),
        Chat, Lighting}, MAX_DESC_SCAN, function(o)
        if seen[o] then return end
        if o:IsA("RemoteEvent") or o:IsA("UnreliableRemoteEvent") or o:IsA("RemoteFunction")
            or o:IsA("BindableEvent") or o:IsA("BindableFunction") then
            seen[o] = true
            table.insert(list, {remote=o, name=o.Name, kind=o.ClassName,
                path=instancePath(o), argCount=0, lastArgs=nil})
        end
    end)
    table.sort(list, function(a,b) return a.path < b.path end)
    caches.REMOTES = list
    return #list
end

local function hookRemoteArgs(remote)
    if not remote then return end
    local ok = pcall(function()
        if remote:GetAttribute("__VMHook") then return end
        remote:SetAttribute("__VMHook", true)
    end)
    if not ok then return end
    if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
        bind(remote.OnClientEvent, function(...)
            local argc = select("#", ...)
            local args = {...}
            for _, e in ipairs(caches.REMOTES) do
                if e.remote == remote then e.argCount = argc; e.lastArgs = args; break end
            end
        end)
    end
end

local function argsPreview(args, argc)
    if not args then return "(none)" end
    local p = {}
    local n = argc or #args
    for i = 1, math.min(n, 5) do p[#p+1] = summarizeValue(args[i], 0, {}) end
    if n > 5 then p[#p+1] = "..." end
    return "(" .. table.concat(p, ",") .. ")"
end

local function scanDecals()
    local list, seen = {}, {}
