local function bind(signal, cb, ownership)
    local ok, conn = pcall(function() return signal:Connect(cb) end)
    if not ok then return nil end
    if ownership then
        local list = state.trackedGui[ownership]
        if list then table.insert(list, conn) end
    else
        table.insert(state.connections, conn)
    end
    return conn
end

local function instancePath(o)
    if typeof(o) ~= "Instance" then return tostring(o) end
    local p, c = {}, o
    for _ = 1, 14 do
        if not c or c == game then break end
        local ok, n, par = pcall(function() return c.Name, c.Parent end)
        if not ok then break end
        table.insert(p, 1, n)
        c = par
    end
    local s = table.concat(p, ".")
    if #s > 240 then s = "..." .. s:sub(-237) end
    return s
end

local function quoteString(v)
    if type(v) ~= "string" then v = tostring(v) end
    local lo = v:lower()
    if #v > 300 or lo:find("bearer ", 1, true) or lo:find("authorization", 1, true)
        or lo:find("password=", 1, true) then
        return "<redacted " .. #v .. "c>"
    end
    return string.format("%q", v:gsub("[\r\n\t]", " "))
end

local function summarizeValue(v, d, seen)
    d = d or 0; seen = seen or {}
    local k = typeof(v)
    if k == "string" then return quoteString(v) end
    if k == "nil" then return "nil" end
    if k == "number" then
        if v == math.floor(v) and math.abs(v) < 1e15 then return tostring(math.floor(v)) end
        return string.format("%.4g", v)
    end
    if k == "boolean" then return tostring(v) end
    if k == "Instance" then return "Inst(" .. instancePath(v) .. ")" end
    if k == "Vector3" then return string.format("V3(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z) end
    if k == "Vector2" then return string.format("V2(%.1f,%.1f)", v.X, v.Y) end
    if k == "CFrame" then local p = v.Position; return string.format("CF(%.1f,%.1f,%.1f)", p.X, p.Y, p.Z) end
    if k == "Color3" then return string.format("RGB(%d,%d,%d)", v.R*255, v.G*255, v.B*255) end
    if k == "UDim2" then return string.format("UD2(%d,%d,%d,%d)", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset) end
    if k == "EnumItem" then return "Enum." .. tostring(v) end
    if k == "BrickColor" then return "BC(" .. tostring(v.Number) .. ")" end
    if k == "NumberRange" then return string.format("NR(%.1f..%.1f)", v.Min, v.Max) end
    if k == "Rect" then return string.format("Rect(%d,%d,%d,%d)", v.Min.X, v.Min.Y, v.Max.X, v.Max.Y) end
    if k == "table" then
        if d >= 3 or seen[v] then return "{...}" end
        seen[v] = true
        local out, total = {}, 0
        for kk, vv in pairs(v) do
            total = total + 1
            if total > 8 then break end
            local lk = tostring(kk):lower()
            local r
            if lk:find("password",1,true) or lk:find("secret",1,true)
                or lk:find("token",1,true) or lk:find("cookie",1,true) then r = "<redacted>"
            else r = summarizeValue(vv, d+1, seen) end
            local kp
            if type(kk) == "string" and kk:match("^[%a_][%w_]*$") then kp = kk
            else kp = "[" .. summarizeValue(kk, d+1, seen) .. "]" end
            table.insert(out, kp .. "=" .. r)
        end
        seen[v] = nil
        return "{" .. table.concat(out, ",") .. (total > 8 and ",..." or "") .. "}"
    end
    return "<" .. tostring(k) .. ">"
end

local function addEntry(cat, msg, rateKey, interval, eventType)
    if not state.alive then return end
    if state.paused and cat ~= "SYSTEM" then return end
    if state.capture[cat] == false then return end
    if rateKey then
        local key = cat .. ":" .. rateKey
        local now = os.clock()
        if state.recent[key] and now - state.recent[key] < (interval or 0.08) then
            state.suppressed = state.suppressed + 1
            return
        end
        state.recent[key] = now
        if state.lifetime % 250 == 0 then
            for k, l in pairs(state.recent) do if now - l > 10 then state.recent[k] = nil end end
        end
    end
    state.lifetime = state.lifetime + 1
    state.stats[cat] = (state.stats[cat] or 0) + 1
    local kind = eventType or tostring(msg):match("^([%w_%.]+)") or cat
    state.eventTypes[kind] = (state.eventTypes[kind] or 0) + 1
    local e = {cat = cat, text = string.format("[#%05d %s] [%s] %s",
        state.lifetime, os.date("%H:%M:%S"), cat, tostring(msg))}
    if state.count < MAX_LINES then
        local pos = (state.head + state.count - 1) % MAX_LINES + 1
        state.entries[pos] = e
        state.count = state.count + 1
    else
        state.entries[state.head] = e
        state.head = state.head % MAX_LINES + 1
        state.overwritten = state.overwritten + 1
    end
    state.dirty = true
end

local function getEntries(filter, maxVisible)
    local lines = {}
    for i = state.count - 1, 0, -1 do
        local idx = (state.head + i - 1) % MAX_LINES + 1
        local it = state.entries[idx]
        if it and (filter == "ALL" or it.cat == filter) then
            lines[#lines + 1] = it.text
            if maxVisible and #lines >= maxVisible then break end
        end
    end
    for l = 1, math.floor(#lines/2) do
        local r = #lines - l + 1
        lines[l], lines[r] = lines[r], lines[l]
    end
    return lines
end

local function report()
    local types = {}
    for n, c in pairs(state.eventTypes) do types[#types+1] = {name=n, count=c} end
    table.sort(types, function(a,b) if a.count==b.count then return a.name<b.name end return a.count>b.count end)
    local freq = {}
    for i=1,math.min(#types,20) do freq[#freq+1] = types[i].name .. "=" .. types[i].count end
    local totals = {}
    for _, c in ipairs(CATEGORIES) do
        if c ~= "ALL" then totals[#totals+1] = c .. "=" .. (state.stats[c] or 0) end
    end
    return table.concat({
        HUB_NAME .. " DUMPER v4.2",
        "Game: " .. tostring(state.gameName) .. "  PlaceId: " .. tostring(game.PlaceId),
        "UniverseId: " .. tostring(game.GameId) .. "  JobId: " .. tostring(game.JobId),
        "Exported: " .. os.date("%Y-%m-%d %H:%M:%S"),
        "Events: " .. state.lifetime .. "  Stored: " .. state.count .. "  Dropped: " .. state.overwritten,
        "Category: " .. table.concat(totals, " | "),
        "Top types: " .. (#freq > 0 and table.concat(freq, " | ") or "none"),
        "Watched: GUI " .. state.guiWatched .. "  REM " .. state.remoteCount ..
            "  INT " .. state.interactCount .. "  AUD " .. state.audioCount,
        "ARG values: " .. (state.capture.ARGS and "ON" or "OFF"),
        "Last: " .. state.lastInteraction,
        "--- LOG START ---",
        table.concat(getEntries("ALL"), "\n"),
        "--- LOG END ---",
    }, "\n")
end

local function ins(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(t, r) ins("UICorner", {CornerRadius = UDim.new(0, r)}, t); return t end
local function stroke(t, color, thickness) ins("UIStroke", {Color = color or COLORS.line, Thickness = thickness or 1}, t); return t end

local function label(parent, text, size, color)
    return ins("TextLabel", {
        BackgroundTransparency = 1, Text = text, TextColor3 = color or COLORS.fg,
        TextSize = size or 11, Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, parent)
end

