local function copyToClipboard(content)
    for _, fn in ipairs({"setclipboard", "toclipboard"}) do
        local f = ENV[fn] or _G[fn]
        if type(f) == "function" then
            local ok = pcall(f, content)
            if ok then return true end
        end
    end
    return false
end

