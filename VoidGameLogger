local function trackGui(g)
    if state.guiWatched >= MAX_GUI_WATCHES then return end
    if not g or state.trackedGui[g] then return end
    state.trackedGui[g] = {}
    state.guiWatched = state.guiWatched + 1
    addEntry("GUI", string.format("CREATED class=%s name=%s path=%s",
        g.ClassName, quoteString(g.Name), instancePath(g)),
        "gui.create:" .. instancePath(g), 0.05, "GUI_CREATED")
    bind(g:GetPropertyChangedSignal("Visible"), function()
        addEntry("GUI", string.format("VISIBLE class=%s name=%s visible=%s path=%s",
            g.ClassName, quoteString(g.Name), tostring(g.Visible), instancePath(g)),
            "gui.vis:" .. instancePath(g), 0.12, "GUI_VISIBLE")
    end, g)
    bind(g:GetPropertyChangedSignal("Text"), function()
        local ok, txt = pcall(function() return g.Text end)
        if ok then
            addEntry("GUI", string.format("TEXT class=%s name=%s text=%s path=%s",
                g.ClassName, quoteString(g.Name), quoteString(txt), instancePath(g)),
                "gui.txt:" .. instancePath(g), 0.15, "GUI_TEXT")
        end
    end, g)
end

local function trackRemote(r)
    if state.remoteCount >= MAX_REMOTE_WATCHES then return end
    if not r or state.trackedRemotes[r] then return end
    if not (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") or r:IsA("RemoteFunction")) then return end
    state.trackedRemotes[r] = true
    state.remoteCount = state.remoteCount + 1
    if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then
        bind(r.OnClientEvent, function(...)
            local argc = select("#", ...)
            local args = {...}
            local render
            if state.capture.ARGS then render = argsPreview(args, argc)
            else
                local t = {}
                for i = 1, argc do t[i] = typeof(args[i]) end
                render = "(" .. table.concat(t, ",") .. ")"
            end
            state.lastInteraction = "RECV " .. r.Name .. " " .. render
            addEntry("REMOTE", string.format("RECV kind=%s name=%s path=%s argc=%d args=%s",
                r.ClassName, quoteString(r.Name), instancePath(r), argc, render),
                "remote.recv:" .. instancePath(r), 0.05, "REMOTE_RECV")
        end, "remote_" .. tostring(r))
    end
end

local function trackInteract(p)
    if state.interactCount >= MAX_INTERACT_WATCHES then return end
    if not p or state.trackedInteract[p] then return end
    if not (p:IsA("ProximityPrompt") or p:IsA("ClickDetector")) then return end
    state.trackedInteract[p] = true
    state.interactCount = state.interactCount + 1
    if p:IsA("ProximityPrompt") then
        bind(p.Triggered, function(plr)
            state.lastInteraction = "PROMPT " .. p.Name
            addEntry("INTERACT", string.format("TRIGGER kind=%s name=%s action=%s object=%s path=%s player=%s",
                p.ClassName, quoteString(p.Name), quoteString(p.ActionText), quoteString(p.ObjectText),
                instancePath(p), plr and plr.Name or "local"),
                "interact.trigger:" .. instancePath(p), 0.1, "INTERACT_TRIGGER")
        end)
    elseif p:IsA("ClickDetector") then
        bind(p.MouseClick, function(plr)
            state.lastInteraction = "CLICK " .. p.Name
            addEntry("INTERACT", string.format("CLICK kind=%s name=%s path=%s player=%s",
                p.ClassName, quoteString(p.Name), instancePath(p), plr and plr.Name or "local"),
                "interact.click:" .. instancePath(p), 0.1, "INTERACT_CLICK")
        end)
    end
end

local function trackAudio(s)
    if state.audioCount >= MAX_AUDIO_WATCHES then return end
    if not s or state.trackedAudio[s] then return end
    if not s:IsA("Sound") then return end
    state.trackedAudio[s] = true
    state.audioCount = state.audioCount + 1
    bind(s:GetPropertyChangedSignal("Playing"), function()
        addEntry("AUDIO", string.format("PLAYING name=%s playing=%s id=%s path=%s",
            quoteString(s.Name), tostring(s.Playing), quoteString(s.SoundId), instancePath(s)),
            "audio.playing:" .. instancePath(s), 0.1, "AUDIO_PLAYING")
    end)
end

local function scanExisting()
    local roots = {Workspace, ReplicatedStorage, PlayerGui, LocalPlayer, SoundService,
        game:GetService("StarterGui"), game:GetService("StarterPlayer"), Lighting, Chat}
    walkRoots(roots, MAX_DESC_SCAN, function(obj)
        if obj:IsA("GuiObject") then trackGui(obj)
        elseif obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("RemoteFunction") then trackRemote(obj)
        elseif obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then trackInteract(obj)
        elseif obj:IsA("Sound") then trackAudio(obj)
        end
    end)
    addEntry("SYSTEM", string.format("BOOT gui=%d rem=%d int=%d aud=%d",
        state.guiWatched, state.remoteCount, state.interactCount, state.audioCount))
end

bind(game.DescendantAdded, function(obj)
    pcall(function()
        if obj:IsA("GuiObject") then trackGui(obj)
        elseif obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("RemoteFunction") then trackRemote(obj)
        elseif obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then trackInteract(obj)
        elseif obj:IsA("Sound") then trackAudio(obj)
        elseif obj:IsA("Tool") then
            addEntry("TOOL", string.format("ADDED name=%s path=%s", quoteString(obj.Name), instancePath(obj)),
                "tool.add:" .. instancePath(obj), 0.1, "TOOL_ADDED")
        end
    end)
end)

bind(UserInputService.InputBegan, function(input, processed)
    if state.capture.INPUT == false then return end
    local kind = input.UserInputType.Name
    local kc = input.KeyCode and input.KeyCode.Name or "None"
    if kind == "Keyboard" then
        addEntry("INPUT", string.format("KEYDOWN key=%s processed=%s", kc, tostring(processed)),
            "input.key:" .. kc, 0.03, "INPUT_KEY")
    elseif kind == "MouseButton1" or kind == "MouseButton2" or kind == "MouseButton3" then
        addEntry("INPUT", string.format("MOUSE button=%s processed=%s", kind, tostring(processed)),
            "input.mouse:" .. kind, 0.03, "INPUT_MOUSE")
    end
end)

local function trackCharacter(ch)
    if not ch then return end
    addEntry("CHARACTER", string.format("SPAWN name=%s path=%s", quoteString(ch.Name), instancePath(ch)),
        "character.spawn", 0.1, "CHARACTER_SPAWN")
    bind(ch.ChildAdded, function(c)
        addEntry("CHARACTER", string.format("CHILD_ADDED name=%s class=%s", quoteString(c.Name), c.ClassName),
            "character.child:" .. instancePath(c), 0.1, "CHARACTER_CHILD")
    end)
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum then
        bind(hum:GetPropertyChangedSignal("Health"), function()
            addEntry("CHARACTER", string.format("HEALTH name=%s health=%.1f max=%.1f",
                quoteString(ch.Name), hum.Health, hum.MaxHealth),
                "character.health:" .. ch.Name, 0.15, "CHARACTER_HEALTH")
        end)
        bind(hum.Died, function()
            addEntry("CHARACTER", string.format("DIED name=%s", quoteString(ch.Name)),
                "character.died", 0.1, "CHARACTER_DIED")
        end)
    end
end

