-- RENDER LOOP
local lastRender = 0
bind(RunService.RenderStepped, function()
    if not state.alive then return end
    if not state.dirty then return end
    local now = os.clock()
    if now - lastRender < 0.1 then return end
    lastRender = now
    state.dirty = false

    local cnt = #(caches[dumpTab] or {})
    statsTop.Text = string.format("%d events  ·  %d stored  ·  %d suppressed  ·  %d in tab",
        state.lifetime, state.count, state.suppressed, cnt)
    local parts = {}
    for _, c in ipairs({"REMOTE","GUI","INTERACT","INPUT","CHARACTER","TOOL","PLAYER","WORLD","AUDIO"}) do
        parts[#parts+1] = c:sub(1,3) .. " " .. state.stats[c]
    end
    statsBot.Text = table.concat(parts, "  ")
    statsBot2.Text = string.format("watching: GUI %d  ·  REM %d  ·  INT %d  ·  AUD %d  ·  ARGS %s",
        state.guiWatched, state.remoteCount, state.interactCount, state.audioCount,
        state.capture.ARGS and "ON" or "OFF")

    if not dumpPanel.Visible then
        local lines = getEntries(state.filter, MAX_ON_SCREEN)
        if #lines == 0 then logText.Text = "Waiting... (" .. state.filter .. ")"
        else logText.Text = table.concat(lines, "\n") end
    end
end)

