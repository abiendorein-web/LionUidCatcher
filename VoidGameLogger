local function scanModels()
    local list, seen = {}, {}
    walkRoots({Workspace, ReplicatedStorage, PlayerGui, LocalPlayer}, MAX_MODEL_SCAN, function(o)
        if seen[o] then return end
        if o:IsA("Model") or o:IsA("Tool") or o:IsA("MeshPart")
            or o:IsA("SpecialMesh") or o:IsA("Accessory") or o:IsA("UnionOperation") then
            seen[o] = true
            local path = instancePath(o)
            local childCount = #o:GetChildren()
            local partCount, meshId, textureId = 0, "", ""
            if o:IsA("Model") or o:IsA("Tool") or o:IsA("Accessory") then
                for _, p in ipairs(o:GetChildren()) do
                    if p:IsA("BasePart") then partCount = partCount + 1 end
                end
                local mesh = o:FindFirstChildWhichIsA("MeshPart", true)
                if mesh then
                    if mesh.MeshId ~= "" then meshId = mesh.MeshId end
                    if mesh.TextureID ~= "" then textureId = mesh.TextureID end
                end
                local h = o:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    local sm = h:FindFirstChildOfClass("SpecialMesh")
                    if sm and sm.MeshId ~= "" then meshId = sm.MeshId end
                    if h:IsA("MeshPart") then
                        if h.MeshId ~= "" then meshId = h.MeshId end
                        if h.TextureID ~= "" then textureId = h.TextureID end
                    end
                end
            elseif o:IsA("MeshPart") then
                meshId = o.MeshId; textureId = o.TextureID; partCount = 1
            elseif o:IsA("SpecialMesh") then
                meshId = o.MeshId; textureId = o.TextureId or ""
            end
            table.insert(list, {object=o, name=o.Name, kind=o.ClassName, path=path,
                childCount=childCount, partCount=partCount, meshId=meshId, textureId=textureId})
        end
    end)
    table.sort(list, function(a,b) return a.path < b.path end)
    caches.MODELS = list
    return #list
end

local function scanAssets()
    local sounds, anims, particles, tools, images, meshes = {}, {}, {}, {}, {}, {}
    walkRoots({Workspace, ReplicatedStorage, SoundService, PlayerGui, LocalPlayer, Lighting}, MAX_DESC_SCAN, function(o)
        if o:IsA("Sound") and o.SoundId ~= "" then
            table.insert(sounds, {name=o.Name, id=o.SoundId, path=instancePath(o)})
        elseif o:IsA("Animation") and o.AnimationId ~= "" then
            table.insert(anims, {name=o.Name, id=o.AnimationId, path=instancePath(o)})
        elseif o:IsA("ParticleEmitter") then
            table.insert(particles, {name=o.Name, id=o.Texture or "", path=instancePath(o)})
        elseif o:IsA("Tool") then
            table.insert(tools, {name=o.Name, path=instancePath(o)})
        elseif o:IsA("Decal") or o:IsA("Texture") then
            table.insert(images, {name=o.Name, id=o.Texture, path=instancePath(o)})
        elseif o:IsA("MeshPart") then
            table.insert(meshes, {name=o.Name, id=o.MeshId, path=instancePath(o)})
        end
    end)
    caches.ASSETS = {Sounds=sounds, Animations=anims, Particles=particles,
        Tools=tools, Images=images, Meshes=meshes}
    return #sounds + #anims + #particles + #tools + #images + #meshes
end

