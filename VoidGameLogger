local renderers = {
    REMOTES=renderRemotes, DECALS=renderDecals, MODELS=renderModels,
    ASSETS=renderAssets, SCRIPTS=renderScripts, PROPS=renderProps,
    VALUES=renderValues, SOUNDS=renderSounds, ANIMS=renderAnims,
    PARTS=renderParts, LIGHTS=renderLights,
}

local function renderDump()
    local fn = renderers[dumpTab]
    if fn then pcall(fn) end
end

local function setTab(name)
    dumpTab = name
    local tabList = {
        {remotesTab,"REMOTES",COLORS.purple},{decalsTab,"DECALS",COLORS.pink},
        {modelsTab,"MODELS",COLORS.cyan},{assetsTab,"ASSETS",COLORS.green},
        {scriptsTab,"SCRIPTS",COLORS.yellow},{propsTab,"PROPS",COLORS.orange},
        {valuesTab,"VALUES",COLORS.cyan},{soundsTab,"SOUNDS",COLORS.accent2},
        {animsTab,"ANIMS",COLORS.orange},{partsTab,"PARTS",COLORS.red},
        {lightTab,"LIGHTS",COLORS.yellow},
    }
    for _, t in ipairs(tabList) do
        local b, n, c = t[1], t[2], t[3]
        if n == name then
            b.BackgroundColor3 = c
            b.TextColor3 = COLORS.bg
        else
            b.BackgroundColor3 = COLORS.elevated
            b.TextColor3 = COLORS.fg
        end
    end
    playAllNoArgs.Visible = (name == "REMOTES")
    playAllWithArgs.Visible = (name == "REMOTES")
    dumpStatus.Text = "Tab: " .. name
    renderDump()
end

local function doScan(name)
    if name=="REMOTES" then
        local n = scanRemotes()
        for _, e in ipairs(caches.REMOTES) do hookRemoteArgs(e.remote) end
        return n
    elseif name=="DECALS" then return scanDecals()
    elseif name=="MODELS" then return scanModels()
    elseif name=="ASSETS" then return scanAssets()
    elseif name=="SCRIPTS" then return scanScripts()
    elseif name=="PROPS" then return scanProps()
    elseif name=="VALUES" then return scanValues()
    elseif name=="SOUNDS" then return scanSounds()
    elseif name=="ANIMS" then return scanAnims()
    elseif name=="PARTS" then return scanParts()
    elseif name=="LIGHTS" then return scanLights()
    end
    return 0
end

local function openTab(name)
    local n = doScan(name)
    setTab(name)
    dumpPanel.Visible = true
    addEntry("SYSTEM", "DUMP tab=" .. name .. " count=" .. n)
    notify(name .. ": " .. n, COLORS.accent)
end

