bind(playAllWithArgs.Activated, function()
    if #caches.REMOTES == 0 then dumpStatus.Text = "No remotes." return end
    local fired, skipped, failed = 0, 0, 0
    for _, e in ipairs(caches.REMOTES) do
        if e.remote and e.remote.Parent then
            if e.lastArgs and #e.lastArgs > 0 then
                local ok = pcall(function()
                    if e.kind=="RemoteFunction" then e.remote:InvokeServer(table.unpack(e.lastArgs))
                    else e.remote:FireServer(table.unpack(e.lastArgs)) end
                end)
                if ok then fired = fired + 1 else failed = failed + 1 end
            else
                skipped = skipped + 1
            end
        end
    end
    dumpStatus.Text = "Args: " .. fired .. ", skipped " .. skipped
end)

