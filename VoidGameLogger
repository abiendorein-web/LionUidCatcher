        elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
            seen[o] = true
            table.insert(list, {object=o, name=o.Name, kind=o.ClassName, texture=o.Image, path=instancePath(o)})
        elseif o:IsA("SurfaceAppearance") then
