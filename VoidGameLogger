    local fired, failed = 0, 0
    for _, e in ipairs(caches.REMOTES) do
        if e.remote and e.remote.Parent then
            local ok = pcall(function()
                if e.kind=="RemoteFunction" then e.remote:InvokeServer()
                elseif e.kind=="BindableFunction" then e.remote:Invoke()
                elseif e.kind=="BindableEvent" then e.remote:Fire()
                else e.remote:FireServer() end
            end)
            if ok then fired = fired + 1 else failed = failed + 1 end
