local function scanRemotes()
    remoteCache = {}
    local seen = {}
    local roots = {
        ReplicatedStorage, Workspace, PlayerGui, LocalPlayer,
        game:GetService("ServerScriptService"),
        game:GetService("StarterGui"),
        game:GetService("StarterPlayer"),
        game:GetService("ServerStorage"),
    }
    for _, root in ipairs(roots) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok and list then
            for _, obj in ipairs(list) do
                if (obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("RemoteFunction")) and not seen[obj] then
                    seen[obj] = true
                    table.insert(remoteCache, {
                        remote = obj,
                        name = obj.Name,
                        kind = obj.ClassName,
                        path = instancePath(obj),
                        argCount = 0,
                        lastArgs = nil,
                    })
                end
            end
        end
    end
    table.sort(remoteCache, function(a, b) return a.path < b.path end)
    return #remoteCache
end

local function hookRemoteArgs(remote)
    if remote:GetAttribute("__VMHook") then return end
    pcall(function() remote:SetAttribute("__VMHook", true) end)
    if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
        bind(remote.OnClientEvent, function(...)
            local argc = select("#", ...)
            local args = {...}
            for _, entry in ipairs(remoteCache) do
                if entry.remote == remote then
                    entry.argCount = argc
                    entry.lastArgs = args
                    break
                end
            end
        end)
    end
end

local function argsPreview(args, argc)
    if not args then return "(none)" end
    local pieces = {}
    local n = argc or #args
    for i = 1, math.min(n, 4) do
        pieces[#pieces + 1] = summarizeValue(args[i], 0, {})
    end
    if n > 4 then pieces[#pieces + 1] = "..." end
    return "(" .. table.concat(pieces, ", ") .. ")"
end

local function scanDecals()
    decalCache = {}
    local seen = {}
    local roots = {Workspace, ReplicatedStorage, PlayerGui, LocalPlayer}
    for _, root in ipairs(roots) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok and list then
            for _, obj in ipairs(list) do
                if seen[obj] then continue end
                if obj:IsA("Decal") or obj:IsA("Texture") then
                    seen[obj] = true
                    table.insert(decalCache, {
                        object = obj, name = obj.Name, kind = obj.ClassName,
                        texture = obj.Texture, path = instancePath(obj),
                    })
                elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    seen[obj] = true
                    table.insert(decalCache, {
                        object = obj, name = obj.Name, kind = obj.ClassName,
                        texture = obj.Image, path = instancePath(obj),
                    })
                end
            end
        end
    end
    table.sort(decalCache, function(a, b) return a.path < b.path end)
    return #decalCache
end

local function scanModels()
    modelCache = {}
    local seen = {}
    local roots = {Workspace, ReplicatedStorage, PlayerGui, LocalPlayer}
    local visited = 0
    for _, root in ipairs(roots) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok and list then
            for _, obj in ipairs(list) do
                if visited >= MAX_MODEL_SCAN then break end
                visited = visited + 1
                if seen[obj] then continue end
                if obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("MeshPart") or obj:IsA("SpecialMesh") or obj:IsA("Accessory") then
                    seen[obj] = true
                    local path = instancePath(obj)
                    local childCount = #obj:GetChildren()
                    local partCount = 0
                    local meshId = ""
                    local textureId = ""
                    local primaryName = ""
                    if obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("Accessory") then
                        for _, p in ipairs(obj:GetChildren()) do
                            if p:IsA("BasePart") then partCount = partCount + 1 end
                        end
                        local pp = obj.PrimaryPart
                        if pp then primaryName = pp.Name end
                        local mesh = obj:FindFirstChildWhichIsA("MeshPart", true)
                        if mesh then
                            if mesh.MeshId ~= "" then meshId = mesh.MeshId end
                            if mesh.TextureID ~= "" then textureId = mesh.TextureID end
                        end
                        local handle = obj:FindFirstChild("Handle")
                        if handle and handle:IsA("BasePart") then
                            local sm = handle:FindFirstChildOfClass("SpecialMesh")
                            if sm and sm.MeshId ~= "" then meshId = sm.MeshId end
                            if handle:IsA("MeshPart") then
                                if handle.MeshId ~= "" then meshId = handle.MeshId end
                                if handle.TextureID ~= "" then textureId = handle.TextureID end
                            end
                        end
                    elseif obj:IsA("MeshPart") then
                        meshId = obj.MeshId
                        textureId = obj.TextureID
                        partCount = 1
                        primaryName = obj.Name
                    elseif obj:IsA("SpecialMesh") then
                        meshId = obj.MeshId
                        textureId = obj.TextureId or ""
                    end
                    table.insert(modelCache, {
                        object = obj, name = obj.Name, kind = obj.ClassName,
                        path = path, childCount = childCount, partCount = partCount,
                        meshId = meshId, textureId = textureId, primaryName = primaryName,
                    })
                end
            end
        end
    end
    table.sort(modelCache, function(a, b) return a.path < b.path end)
    return #modelCache
end

local function scanAssets()
    assetCache = {Sounds = {}, Animations = {}, Particles = {}, Tools = {}}
    local roots = {Workspace, ReplicatedStorage, SoundService, PlayerGui, LocalPlayer}
    for _, root in ipairs(roots) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok and list then
            for _, obj in ipairs(list) do
                if obj:IsA("Sound") and obj.SoundId ~= "" then
                    table.insert(assetCache.Sounds, {name = obj.Name, id = obj.SoundId, path = instancePath(obj)})
                elseif obj:IsA("Animation") and obj.AnimationId ~= "" then
                    table.insert(assetCache.Animations, {name = obj.Name, id = obj.AnimationId, path = instancePath(obj)})
                elseif obj:IsA("ParticleEmitter") then
                    table.insert(assetCache.Particles, {name = obj.Name, id = obj.Texture or "", path = instancePath(obj)})
                elseif obj:IsA("Tool") then
                    table.insert(assetCache.Tools, {name = obj.Name, path = instancePath(obj)})
                end
            end
        end
    end
    return assetCache
end

