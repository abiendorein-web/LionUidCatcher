local function saveReportTxt()
    local writer = ENV.writefile or _G.writefile or writefile
    if type(writer) ~= "function" then
        exportStatus("SAVE TXT UNAVAILABLE", "Your executor does not expose writefile().\n\nUse COPY ALL, or switch to an executor that supports saving workspace files.")
        addEntry("SYSTEM", "SAVE_TXT_UNAVAILABLE writefile() not supported")
        return nil
    end

    local safeGameName = tostring(state.gameName or "Game")
        :gsub("[^%w%s%-_]", "")
        :gsub("%s+", "_")
        :gsub("^_+", "")
        :gsub("_+$", "")
        :sub(1, 40)
    if safeGameName == "" then safeGameName = "Game" end
    state.saveSequence = (state.saveSequence or 0) + 1
    local prefix = "MorantxHub_" .. safeGameName .. "_" .. tostring(game.PlaceId) ..
        "_" .. os.date("%Y%m%d_%H%M%S")
    local function fileName()
        return prefix .. "_" .. tostring(state.saveSequence) .. ".txt"
    end
    local filename = fileName()
    local fileExists = ENV.isfile or _G.isfile or isfile
    if type(fileExists) == "function" then
        for _ = 1, 100 do
            local ok, exists = pcall(fileExists, filename)
            if not ok or not exists then break end
            state.saveSequence = state.saveSequence + 1
            filename = fileName()
        end
    end

    local entryCount = state.count
    local content = report()
    local ok, err = pcall(writer, filename, content)
    if not ok then
        exportStatus("SAVE TXT FAILED", "File: " .. filename .. "\n\n" .. tostring(err))
        addEntry("SYSTEM", "SAVE_TXT_FAILED: " .. tostring(err))
        return nil
    end

    local reader = ENV.readfile or _G.readfile or readfile
    if type(reader) == "function" then
        local readOK, savedContent = pcall(reader, filename)
        if not readOK or savedContent ~= content then
            exportStatus("SAVE TXT COULD NOT BE VERIFIED",
                "File: " .. filename .. "\n\nThe executor reported saving, but readback did not match the complete report. Check the file before uploading it.")
            addEntry("SYSTEM", "SAVE_TXT_READBACK_MISMATCH file=" .. filename)
            return nil
        end
    end

    exportStatus("TXT SAVED TO EXECUTOR WORKSPACE",
        "Filename: " .. filename ..
        "\n\nSaved events: " .. tostring(entryCount) ..
        "\nFile bytes: " .. tostring(#content) ..
        "\n\nOpen your executor's workspace/files directory, locate this file, and upload it to ChatGPT." ..
        "\n\nThe file ends with --- LOG END ---. Rate-limited and overwritten events cannot be recovered.")
    addEntry("SYSTEM", "SAVE_TXT_SUCCESS file=" .. filename ..
        " savedEvents=" .. tostring(entryCount) .. " bytes=" .. tostring(#content))
    saveButton.Text = "SAVED!"
    task.delay(1.5, function()
        if state.alive then saveButton.Text = "SAVE TXT" end
    end)
    return filename
end

