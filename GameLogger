local function copyToClipboard(content)
    for _, fnName in ipairs({"setclipboard", "toclipboard"}) do
        local fn = ENV[fnName] or _G[fnName]
        if type(fn) == "function" then
            local ok = pcall(fn, content)
            if ok then return true end
        end
    end
    return false
end

