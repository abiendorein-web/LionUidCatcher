state.PlayAllRemotes = function()
    if #remoteCache == 0 then scanRemotes() end
    local fired, failed = 0, 0
    for _, entry in ipairs(remoteCache) do
        if entry.remote and entry.remote.Parent then
            local ok = pcall(function()
                if entry.kind == "RemoteFunction" then
                    entry.remote:InvokeServer()
                else
                    entry.remote:FireServer()
                end
            end)
            if ok then fired = fired + 1 else failed = failed + 1 end
        end
    end
    return fired, failed
end
