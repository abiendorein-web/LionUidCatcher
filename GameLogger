end)

local function sensitiveKey(key)
    key = string.lower(tostring(key))
    return key:find("token", 1, true) or key:find("password", 1, true)
        or key:find("cookie", 1, true) or key:find("secret", 1, true)
        or key:find("auth", 1, true) or key:find("webhook", 1, true)
        or key:find("sessionid", 1, true)
end

local function valueDisplay(name, value)
    if sensitiveKey(name) then return "<redacted>" end
    if typeof(value) == "string" and not state.capture.ARGS then
        return "<text omitted; enable ARGS for short values>"
    end
    return summarizeValue(value, 0, {})
end

