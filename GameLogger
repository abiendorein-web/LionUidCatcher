state.onRemote = function(remote, method, count, args)
    local pieces = {}
    for i = 1, math.min(count, 7) do
        local value = args[i]
        if state.capture.ARGS then
            table.insert(pieces, summarizeValue(value, 0, {}))
        else
            table.insert(pieces, typeof(value))
        end
    end
    if count > 7 then table.insert(pieces, "... +" .. (count - 7) .. " args") end
    local path = instancePath(remote)
    addEntry("REMOTE", "REMOTE_" .. method .. " name=" .. quoteString(remote.Name)
        .. " path=" .. path .. " args=(" .. table.concat(pieces, ", ") .. ")",
        path .. ":" .. method, 0.035, "REMOTE_" .. method)
end

local canHook = type(hookmetamethod) == "function" and
    type(getnamecallmethod) == "function"
state.remoteSupported = canHook or (ENV.__MorantActionRecorderHook == true)
ENV.MorantActionRecorder = state

if canHook and not ENV.__MorantActionRecorderHook then
    local wrap = type(newcclosure) == "function" and newcclosure or function(fn) return fn end
    local oldNamecall
    local success = pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local kind = typeof(self) == "Instance" and self.ClassName or ""
                if kind == "RemoteEvent" or kind == "RemoteFunction" then
                    local current = ENV.MorantActionRecorder
                    if current and current.alive and current.capture.REMOTE then
                        local argc, arguments = select("#", ...), {...}
                        pcall(current.onRemote, self, method, argc, arguments)
                    end
                end
            end
            return oldNamecall(self, ...)
        end))
    end)
    if success and oldNamecall then
        ENV.__MorantActionRecorderHook = true
        state.remoteSupported = true
    else
        state.remoteSupported = false
    end
end

local function releaseOwned(map, object, counter)
    local connections = map[object]
    if not connections then return end
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    map[object] = nil
    if counter then state[counter] = math.max(0, state[counter] - 1) end
end

local function bindOwned(map, object, signal, callback)
    local ok, connection = pcall(function() return signal:Connect(callback) end)
    if ok and connection then
        map[object] = map[object] or {}
        table.insert(map[object], connection)
        return connection
    end
    return nil
end

local function describeArgs(argc, args)
    local pieces = {}
    for i = 1, math.min(argc, 7) do
        local value = args[i]
        pieces[#pieces + 1] = state.capture.ARGS and summarizeValue(value, 0, {}) or typeof(value)
    end
    if argc > 7 then pieces[#pieces + 1] = "... +" .. (argc - 7) .. " args" end
    return table.concat(pieces, ", ")
end

local function watchRemote(object)
    if state.trackedRemotes[object] then return end
    if not (object:IsA("RemoteEvent") or object:IsA("UnreliableRemoteEvent")) then return end
    if state.remoteCount >= MAX_REMOTE_WATCHES then
        state.watchLimits.REMOTE = state.watchLimits.REMOTE + 1
        return
    end
    state.trackedRemotes[object] = {}
    state.remoteCount = state.remoteCount + 1
    bindOwned(state.trackedRemotes, object, object.OnClientEvent, function(...)
        local count = select("#", ...)
        local arguments = {...}
        local path = instancePath(object)
        addEntry("REMOTE", "REMOTE_RECEIVE name=" .. quoteString(object.Name)
            .. " path=" .. path .. " args=(" .. describeArgs(count, arguments) .. ")",
            path .. ":RECEIVE", 0.035, "REMOTE_RECEIVE")
    end)
end

local function watchWorldInteraction(object)
    if state.trackedInteract[object] then return end
    if not (object:IsA("ClickDetector") or object:IsA("DragDetector")) then return end
    if state.interactCount >= MAX_INTERACT_WATCHES then
        state.watchLimits.INTERACT = state.watchLimits.INTERACT + 1
        return
    end
    state.trackedInteract[object] = {}
    state.interactCount = state.interactCount + 1
    if object:IsA("ClickDetector") then
        bindOwned(state.trackedInteract, object, object.MouseClick, function(player)
            if player == LocalPlayer then
                local action = "CLICK_DETECTOR_PRESS path=" .. instancePath(object)
                state.lastInteraction = action
                addEntry("INTERACT", action)
            end
        end)
        pcall(function()
            bindOwned(state.trackedInteract, object, object.RightMouseClick, function(player)
                if player == LocalPlayer then
                    addEntry("INTERACT", "CLICK_DETECTOR_RIGHT_PRESS path=" .. instancePath(object))
                end
            end)
        end)
    else
        for _, signalName in ipairs({"DragStart", "DragEnd"}) do
            pcall(function()
                bindOwned(state.trackedInteract, object, object[signalName], function()
                    local action = "DRAG_" .. string.upper(signalName)
                        .. " path=" .. instancePath(object)
                    state.lastInteraction = action
                    addEntry("INTERACT", action)
                end)
            end)
        end
    end
end

local function watchSound(object)
    if not object:IsA("Sound") or state.trackedAudio[object] then return end
    if state.audioCount >= MAX_AUDIO_WATCHES then
        state.watchLimits.AUDIO = state.watchLimits.AUDIO + 1
        return
    end
    state.trackedAudio[object] = {}
    state.audioCount = state.audioCount + 1
    bindOwned(state.trackedAudio, object, object.Played, function()
        addEntry("AUDIO", "SOUND_PLAY name=" .. quoteString(object.Name)
            .. " path=" .. instancePath(object), instancePath(object) .. ":play", 0.08)
    end)
    bindOwned(state.trackedAudio, object, object.Ended, function()
        addEntry("AUDIO", "SOUND_END name=" .. quoteString(object.Name)
            .. " path=" .. instancePath(object), instancePath(object) .. ":end", 0.08)
    end)
    bindOwned(state.trackedAudio, object, object.Stopped, function()
        addEntry("AUDIO", "SOUND_STOP name=" .. quoteString(object.Name)
            .. " path=" .. instancePath(object), instancePath(object) .. ":stop", 0.08)
    end)
end

local function observeGameObject(object)
    if not state.alive then return end
    if object:IsA("RemoteEvent") or object:IsA("UnreliableRemoteEvent") then
        watchRemote(object)
    elseif object:IsA("ClickDetector") or object:IsA("DragDetector") then
        watchWorldInteraction(object)
    elseif object:IsA("Sound") then
        watchSound(object)
    end
end

local function unobserveGameObject(object)
    releaseOwned(state.trackedRemotes, object, "remoteCount")
    releaseOwned(state.trackedInteract, object, "interactCount")
    releaseOwned(state.trackedAudio, object, "audioCount")
end

