local positionSample, sampleTime = nil, os.clock()
bind(RunService.Heartbeat, function()
    local now = os.clock()
    if now - sampleTime < 0.75 then return end
    local elapsed = now - sampleTime
    sampleTime = now
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then positionSample = nil return end
    local position = root.Position
    if positionSample then
        local traveled = (position - positionSample).Magnitude
        if traveled > math.max(55, elapsed * 95) then
            addEntry("CHARACTER", string.format(
                "RAPID_POSITION_CHANGE distance=%.1f from=(%s) to=(%s)",
                traveled, tostring(positionSample), tostring(position)),
                "rapid-position", 0.2)
        end
    end
    positionSample = position
end)

