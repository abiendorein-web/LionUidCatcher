local function snapToDock()
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local vs = camera.ViewportSize
    local halfW = vs.X / 2
    local halfH = vs.Y / 2
    local centerX = main.Position.X.Offset + halfW
    local centerY = main.Position.Y.Offset + halfH
    local leftDist = math.abs(centerX)
    local rightDist = math.abs(vs.X - centerX)
    local topDist = math.abs(centerY)
    local bottomDist = math.abs(vs.Y - centerY)
    local minDist = math.min(leftDist, rightDist, topDist, bottomDist)
    if minDist == leftDist then
        state.dockSide = "left"
        main.Position = UDim2.new(0, 8, main.Position.Y.Scale, main.Position.Y.Offset)
    elseif minDist == rightDist then
        state.dockSide = "right"
        main.Position = UDim2.new(1, -675 - 8, main.Position.Y.Scale, main.Position.Y.Offset)
    elseif minDist == topDist then
        state.dockSide = "top"
        main.Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset, 0, 8)
    else
        state.dockSide = "bottom"
        main.Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset, 1, -530 - 8)
    end
    dockHint.Text = "docked: " .. state.dockSide
    notify("Docked " .. state.dockSide, COLORS.accent)
end

