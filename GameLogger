local function watchValue(object)
    if state.trackedValues[object] or not object:IsA("ValueBase") then return end
    state.trackedValues[object] = {}
    bindOwned(state.trackedValues, object, object.Changed, function(value)
        addEntry("PLAYER", "VALUE_CHANGED name=" .. quoteString(object.Name)
            .. " value=" .. summarizeValue(value, 0, {}), instancePath(object), 0.06)
    end)
end

