local function onCharacter(character)
    addEntry("CHARACTER", "CHARACTER SPAWN " .. instancePath(character))
    for _, child in ipairs(character:GetChildren()) do watchTool(child) end
    bind(character.ChildAdded, function(child)
        watchTool(child)
        if child:IsA("Tool") then
            addEntry("TOOL", "CHARACTER_TOOL_EQUIPPED name=" .. quoteString(child.Name))
        end
    end)
    bind(character.ChildRemoved, function(child)
        if child:IsA("Tool") then
            addEntry("TOOL", "CHARACTER_TOOL_REMOVED name=" .. quoteString(child.Name))
        end
    end)
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    bind(humanoid.Died, function() addEntry("CHARACTER", "DIED") end)
    bind(humanoid.StateChanged, function(_, nextState)
        if nextState == Enum.HumanoidStateType.Jumping
            or nextState == Enum.HumanoidStateType.Freefall
            or nextState == Enum.HumanoidStateType.Landed
            or nextState == Enum.HumanoidStateType.Seated
            or nextState == Enum.HumanoidStateType.Swimming
            or nextState == Enum.HumanoidStateType.Climbing then
            addEntry("CHARACTER", "STATE " .. nextState.Name, nextState.Name, 0.3)
        end
