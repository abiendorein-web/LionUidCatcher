local function bind(signal, callback, ownership)
    local success, connection = pcall(function() return signal:Connect(callback) end)
    if not success then return nil end
    if ownership then
        local list = state.trackedGui[ownership]
        if list then table.insert(list, connection) end
    else
        table.insert(state.connections, connection)
    end
    return connection
end

local function instancePath(object)
    if typeof(object) ~= "Instance" then return tostring(object) end
    local pieces = {}
    local cursor = object
    for _ = 1, 12 do
        if not cursor or cursor == game then break end
        local ok, name, parent = pcall(function()
            return cursor.Name, cursor.Parent
        end)
        if not ok then break end
        table.insert(pieces, 1, name)
        cursor = parent
    end
    local path = table.concat(pieces, ".")
    if #path > 200 then path = "..." .. path:sub(-197) end
    return path
end

local function quoteString(value)
    local lower = string.lower(value)
    if #value > 160 or lower:find("bearer ", 1, true)
        or lower:find("token=", 1, true)
        or lower:find("password=", 1, true)
        or lower:find("authorization", 1, true)
        or lower:find("https://", 1, true)
        or lower:find("http://", 1, true) then
        return "<redacted string, " .. #value .. " chars>"
    end
    return string.format("%q", value:gsub("[\r\n]", " "))
end

local function summarizeValue(value, depth, seen)
    local kind = typeof(value)
    if kind == "string" then return quoteString(value) end
    if kind == "nil" then return "nil" end
    if kind == "number" or kind == "boolean" then return tostring(value) end
    if kind == "Instance" then return "Instance(" .. instancePath(value) .. ")" end
    if kind == "Vector3" or kind == "Vector2" or kind == "CFrame"
        or kind == "Color3" or kind == "UDim2" or kind == "EnumItem" then
        return kind .. "(" .. tostring(value) .. ")"
    end
    if kind == "table" then
        if depth >= 2 or seen[value] then return "{...}" end
        seen[value] = true
        local items, total = {}, 0
        for k, v in pairs(value) do
            total = total + 1
            if total > 6 then break end
            local lowerKey = tostring(k):lower()
            local rendered = "<redacted>"
            if not (lowerKey:find("password", 1, true)
                or lowerKey:find("secret", 1, true)
                or lowerKey:find("token", 1, true)
                or lowerKey:find("cookie", 1, true)) then
                rendered = summarizeValue(v, depth + 1, seen)
            end
            table.insert(items, tostring(k) .. "=" .. rendered)
        end
        seen[value] = nil
        return "{" .. table.concat(items, ", ") .. (total > 6 and ", ..." or "") .. "}"
    end
    return "<" .. kind .. ">"
end

local function addEntry(category, message, rateKey, interval, eventType)
    if not state.alive or (state.paused and category ~= "SYSTEM") then return end
    if state.capture[category] == false then return end

    if rateKey then
        local key = category .. ":" .. rateKey
        local now = os.clock()
        if state.recent[key] and now - state.recent[key] < (interval or 0.08) then
            state.suppressed = state.suppressed + 1
            return
        end
        state.recent[key] = now
        if state.lifetime % 250 == 0 then
            for oldKey, last in pairs(state.recent) do
                if now - last > 10 then state.recent[oldKey] = nil end
            end
        end
    end

    state.lifetime = state.lifetime + 1
    state.stats[category] = (state.stats[category] or 0) + 1
    local kind = eventType or tostring(message):match("^([%w_%.]+)") or category
    state.eventTypes[kind] = (state.eventTypes[kind] or 0) + 1
    local event = {
        category = category,
        text = string.format("[#%05d %s.%03d] [%s] %s", state.lifetime,
            os.date("%H:%M:%S"), math.floor(os.clock() % 1 * 1000),
            category, tostring(message)),
    }
    if state.count < MAX_LINES then
        local position = (state.head + state.count - 1) % MAX_LINES + 1
        state.entries[position] = event
        state.count = state.count + 1
    else
        state.entries[state.head] = event
        state.head = state.head % MAX_LINES + 1
        state.overwritten = state.overwritten + 1
    end
    state.dirty = true
end

local function getEntries(filter, maxVisible)
    local lines = {}
    for i = state.count - 1, 0, -1 do
        local index = (state.head + i - 1) % MAX_LINES + 1
        local item = state.entries[index]
        if item and (filter == "ALL" or item.category == filter) then
            lines[#lines + 1] = item.text
            if maxVisible and #lines >= maxVisible then break end
        end
    end
    for left = 1, math.floor(#lines / 2) do
        local right = #lines - left + 1
        lines[left], lines[right] = lines[right], lines[left]
    end
    return lines
end

local function report()
    local totals, types = {}, {}
    for name, count in pairs(state.eventTypes) do
        types[#types + 1] = {name = name, count = count}
    end
    table.sort(types, function(a, b)
        if a.count == b.count then return a.name < b.name end
        return a.count > b.count
    end)
    local frequent = {}
    for i = 1, math.min(#types, 20) do
        frequent[#frequent + 1] = types[i].name .. "=" .. types[i].count
    end
    for _, category in ipairs(CATEGORIES) do
        if category ~= "ALL" then
            table.insert(totals, category .. "=" .. (state.stats[category] or 0))
        end
    end
    return table.concat({
        HUB_NAME .. " UNIVERSAL GAME LOGGER v3.1 | CLIENT-OBSERVED SESSION",
        "Game: " .. tostring(state.gameName),
        "PlaceId: " .. tostring(game.PlaceId) .. " | UniverseId: " .. tostring(game.GameId),
        "Exported at: " .. os.date("%Y-%m-%d %H:%M:%S"),
        "Recorded events: " .. state.lifetime .. " | Stored: " .. state.count,
        "Overwritten: " .. state.overwritten .. " | Rate-limited: " .. state.suppressed,
        "Category counts: " .. table.concat(totals, " | "),
        "Top event types: " .. (#frequent > 0 and table.concat(frequent, " | ") or "none"),
        "Watched: GUI " .. state.guiWatched .. ", remotes " .. state.remoteCount ..
            ", interactions " .. state.interactCount .. ", audio " .. state.audioCount,
        "Watch limits hit: " .. table.concat({"GUI=" .. state.watchLimits.GUI,
            "REMOTE=" .. state.watchLimits.REMOTE,
            "INTERACT=" .. state.watchLimits.INTERACT,
            "AUDIO=" .. state.watchLimits.AUDIO}, " | "),
        "Outgoing remote hook: " .. (state.remoteSupported and "available" or "unavailable"),
        "Incoming RemoteEvent listeners: " .. tostring(state.remoteCount),
        "Remote argument values: " .. (state.capture.ARGS and "ON (review before sharing)" or "OFF (types only)"),
        "Most recent action: " .. state.lastInteraction,
        "--- LOG START (oldest to newest) ---",
        table.concat(getEntries("ALL"), "\n"),
        "--- LOG END ---",
    }, "\n")
end

local function instance(className, properties, parent)
    local object = Instance.new(className)
    for k, v in pairs(properties or {}) do object[k] = v end
    object.Parent = parent
    return object
end

