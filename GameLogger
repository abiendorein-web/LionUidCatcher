-- ============================================================
-- GUI WATCHERS
-- ============================================================
local function isOurGui(obj)
    return obj == gui or obj:IsDescendantOf(gui)
end

local function shouldWatchVisibility(obj)
    if not obj:IsA("GuiObject") or obj:IsA("TextLabel") then return false end
    local name = obj.Name:lower()
    if name:find("menu", 1, true) or name:find("panel", 1, true)
        or name:find("shop", 1, true) or name:find("popup", 1, true)
        or name:find("window", 1, true) or name:find("dialog", 1, true)
        or name:find("inventory", 1, true) or name:find("trade", 1, true)
        or name:find("quest", 1, true) then
        return true
    end
    local depth, current = 0, obj
    while current and current ~= PlayerGui and depth <= 5 do
        if current:IsA("ScreenGui") then return depth <= 12 end
        current, depth = current.Parent, depth + 1
    end
    return false
end

local function unwatchGui(obj)
    local owned = state.trackedGui[obj]
    if not owned then return end
    for _, connection in ipairs(owned) do pcall(function() connection:Disconnect() end) end
    state.trackedGui[obj] = nil
    state.guiWatched = math.max(0, state.guiWatched - 1)
end

local function watchGui(obj)
    if not state.alive or state.trackedGui[obj] or isOurGui(obj) then return end
    if state.guiWatched >= MAX_GUI_WATCHES then
        state.watchLimits.GUI = state.watchLimits.GUI + 1
        return
    end
    local observe = obj:IsA("ScreenGui") or obj:IsA("GuiButton") or
        obj:IsA("TextBox") or shouldWatchVisibility(obj)
    if not observe then return end
    state.trackedGui[obj] = {}
    state.guiWatched = state.guiWatched + 1
    if obj:IsA("ScreenGui") then
        bind(obj:GetPropertyChangedSignal("Enabled"), function()
            addEntry("GUI", (obj.Enabled and "MENU_OPEN " or "MENU_CLOSE ")
                .. "name=" .. quoteString(obj.Name), instancePath(obj), 0.05)
        end, obj)
    end
    if obj:IsA("GuiButton") then
        bind(obj.Activated, function(_, clickCount)
            local label = ""
            if obj:IsA("TextButton") then label = obj.Text end
            if label == "" then
                local child = obj:FindFirstChildWhichIsA("TextLabel", true)
                if child then label = child.Text end
            end
            if label == "" then label = obj.Name end
            local action = "BUTTON_PRESS label=" .. quoteString(label)
                .. " name=" .. quoteString(obj.Name) .. " path=" .. instancePath(obj)
                .. " count=" .. tostring(clickCount or 0)
            state.lastInteraction = action
            addEntry("GUI", action, nil, nil, "BUTTON_PRESS")
        end, obj)
    end
    if obj:IsA("TextBox") then
        bind(obj.Focused, function()
            addEntry("GUI", "TEXTBOX_FOCUS name=" .. quoteString(obj.Name))
        end, obj)
        bind(obj.FocusLost, function(submitted)
            addEntry("GUI", "TEXTBOX_BLUR name=" .. quoteString(obj.Name)
                .. " enter=" .. tostring(submitted))
        end, obj)
    end
    if shouldWatchVisibility(obj) then
        bind(obj:GetPropertyChangedSignal("Visible"), function()
            addEntry("GUI", (obj.Visible and "UI_SHOW " or "UI_HIDE ")
                .. "name=" .. quoteString(obj.Name))
        end, obj)
    end
end

