state.Destroy = function()
    if not state.alive then return end
    state.alive = false
    for _, connection in ipairs(state.connections) do
        pcall(function() connection:Disconnect() end)
    end
    for watched in pairs(state.trackedGui) do unwatchGui(watched) end
    for object in pairs(state.trackedRemotes) do releaseOwned(state.trackedRemotes, object, "remoteCount") end
    for object in pairs(state.trackedInteract) do releaseOwned(state.trackedInteract, object, "interactCount") end
    for object in pairs(state.trackedAudio) do releaseOwned(state.trackedAudio, object, "audioCount") end
    for object in pairs(state.trackedValues) do releaseOwned(state.trackedValues, object) end
    pcall(function() gui:Destroy() end)
    if ENV.MorantActionRecorder == state then ENV.MorantActionRecorder = nil end
end

