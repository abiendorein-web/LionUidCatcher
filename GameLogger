                if entry.kind == "RemoteFunction" then
                    entry.remote:InvokeServer()
                else
                    entry.remote:FireServer()
                end
            end)
            if ok then
                remoteStatus.Text = "Fired " .. entry.name .. " (no args)"
                addEntry("REMOTE", "MANUAL_FIRE name=" .. quoteString(entry.name) .. " path=" .. entry.path .. " args=()")
            else
                remoteStatus.Text = "Fire failed: " .. entry.name
            end
        end)

        bind(fireArgsBtn.Activated, function()
            if not (entry.remote and entry.remote.Parent) then
                remoteStatus.Text = "Remote gone: " .. entry.name
                return
            end
            if not entry.lastArgs then
                remoteStatus.Text = "No args recorded for " .. entry.name
                return
            end
            local ok = pcall(function()
                if entry.kind == "RemoteFunction" then
                    entry.remote:InvokeServer(table.unpack(entry.lastArgs))
                else
                    entry.remote:FireServer(table.unpack(entry.lastArgs))
                end
            end)
            if ok then
                remoteStatus.Text = "Fired " .. entry.name .. " with " .. tostring(#entry.lastArgs) .. " arg(s)"
                addEntry("REMOTE", "MANUAL_FIRE name=" .. quoteString(entry.name) .. " path=" .. entry.path .. " args=" .. argsPreview(entry.lastArgs, #entry.lastArgs))
            else
                remoteStatus.Text = "Fire ARGS failed: " .. entry.name
            end
        end)
    end
end

